<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The bundle is signed ad hoc (no paid Apple Developer ID), so the hardened runtime needs these to run .NET at
         all: allow-jit lets the CLR's JIT map executable pages, disable-library-validation lets it load its own
         ad-hoc-signed dylibs (libhostfxr, Skia, Whisper) that carry no Team ID to match the app's. -->
    <key>com.apple.security.cs.allow-jit</key><true/>
    <key>com.apple.security.cs.disable-library-validation</key><true/>
    <key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>
