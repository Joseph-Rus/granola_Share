<!-- An assignment's detail (design 09/10, Windows): a plain toolbar row over Fluent cards. Draws no outer padding or
     window — the library window's detail column gives the frame. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             x:Class="StudyStash.App.Views.WinAssignment"
             x:DataType="vm:AssignmentModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://StudyStash/Views/WinCanvasStyles.axaml" />
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <Grid Grid.Row="0" Height="48" ColumnDefinitions="*,Auto,Auto" Margin="0,0,16,0">
      <Button Grid.Column="1" Classes="cv-toolbtn" Command="{Binding OpenInCanvasCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <c:Icon Glyph="open_in_new" Size="16" />
          <TextBlock Text="Open in Canvas" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Classes="cv-toolicon" Command="{Binding SearchCommand}">
        <c:Icon Glyph="more_horiz" Size="18" />
      </Button>
    </Grid>
    <Panel Grid.Row="1" ClipToBounds="True">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="620" Margin="48,4,48,48" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center" />
            <TextBlock Classes="cv-meta" Text="{Binding Meta}" />
          </StackPanel>
          <TextBlock Classes="cv-detail-title" Text="{Binding Title}" TextWrapping="Wrap" Margin="0,0,0,8" />

          <Border Classes="cv-tiles">
            <Grid ColumnDefinitions="*,1,*,1,*">
              <StackPanel Grid.Column="0" Spacing="2" Margin="16,12">
                <TextBlock Classes="cv-tile-label" Text="Due" />
                <TextBlock Classes="cv-tile-value" Text="{Binding DueValue}" />
              </StackPanel>
              <Border Grid.Column="1" Classes="cv-tile-sep" />
              <StackPanel Grid.Column="2" Spacing="2" Margin="16,12">
                <TextBlock Classes="cv-tile-label" Text="Points" />
                <TextBlock Classes="cv-tile-value" Text="{Binding PointsValue}" />
              </StackPanel>
              <Border Grid.Column="3" Classes="cv-tile-sep" />
              <StackPanel Grid.Column="4" Spacing="2" Margin="16,12">
                <TextBlock Classes="cv-tile-label" Text="{Binding ThirdLabel}" />
                <TextBlock Classes="cv-tile-value" Text="{Binding ThirdValue}" />
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Classes="cv-h3" Text="Instructions" Margin="0,6,0,0" IsVisible="{Binding Instructions, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding Instructions}" FontSize="15" LineHeight="24" TextWrapping="Wrap"
                     IsVisible="{Binding Instructions, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <TextBlock Classes="cv-h3" Text="Rubric" Margin="0,2,0,0" IsVisible="{Binding HasRubric}" />
          <ItemsControl ItemsSource="{Binding Rubric}" IsVisible="{Binding HasRubric}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RubricRow">
                <StackPanel Spacing="2" Margin="0,10">
                  <Border Classes="cv-rule" Margin="0,-10,0,10" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="cv-rubric-crit" Text="{Binding Criterion}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Classes="cv-rubric-pts" Text="{Binding Right}" Margin="16,0,0,0" />
                  </Grid>
                  <TextBlock Classes="cv-rubric-comment" Text="{Binding Comment}" IsVisible="{Binding Comment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="cv-h3" Text="Your submission" Margin="0,2,0,0" />
          <Border Classes="cv-submission">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="cv-sub-status" Text="{Binding SubmissionStatus}" />
                <TextBlock Classes="cv-sub-detail" Text="{Binding SubmissionDetail}" IsVisible="{Binding HasSubmissionDetail}" VerticalAlignment="Bottom" />
              </StackPanel>
              <StackPanel Spacing="2" IsVisible="{Binding HasComment}">
                <TextBlock Classes="cv-comment" Text="{Binding CommentText}" />
                <TextBlock Classes="cv-comment-author" Text="{Binding CommentAuthor}" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Files}" IsVisible="{Binding HasFiles}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FileChip">
                    <Button Theme="{StaticResource Surface}" Padding="0" Margin="0,0,8,8" Command="{Binding OpenCommand}">
                      <Border Classes="cv-chip">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <c:Icon Glyph="{Binding Glyph}" Size="16" Foreground="{DynamicResource Fg2}" />
                          <TextBlock Classes="cv-chip-name" Text="{Binding Name}" />
                          <TextBlock Classes="cv-chip-size" Text="{Binding SizeText}" />
                        </StackPanel>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="cv-hand-in" IsVisible="{Binding ShowHandInLink}" Command="{Binding HandInCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Classes="cv-hand-in" Text="Hand it in on Canvas" />
                  <c:Icon Glyph="arrow_outward" Size="16" Foreground="{DynamicResource AccentText}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Border x:Name="BottomFade" Height="64" VerticalAlignment="Bottom" IsHitTestVisible="False" />
    </Panel>
  </Grid>
</UserControl>
