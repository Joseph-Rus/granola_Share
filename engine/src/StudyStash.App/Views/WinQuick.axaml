<!-- The quick panel (Surfaces, Windows 11 03): Alt+Shift+Space. Fluent list selection: a subtle fill and the accent pill.
     Ctrl+Enter asks; the answer sits in a card with its sources below. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             x:Class="StudyStash.App.Views.WinQuick"
             x:DataType="vm:QuickModel"
             Width="680" ClipToBounds="False">
  <UserControl.Styles>
    <Style Selector="Border.kbd">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource Ctrl}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.kbd > TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector="Button.qrow">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Margin" Value="4,0,4,2" />
    </Style>
    <Style Selector="Button.qrow.selected">
      <Setter Property="Background" Value="{DynamicResource Subtle2}" />
    </Style>
    <Style Selector="Border.pill">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.qrow.selected Border.pill">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.qrow.selected c|Icon.source">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="Margin" Value="16,12,16,6" />
    </Style>
    <Style Selector="TextBlock.header.first">
      <Setter Property="Margin" Value="16,6,16,6" />
    </Style>
    <Style Selector="Button.qrow.selected c|Icon.source">
      <Setter Property="Filled" Value="True" />
    </Style>
    <Style Selector="ItemsControl.answer">
      <Setter Property="Margin" Value="4,8,4,8" />
    </Style>
    <Style Selector="ItemsControl.answer TextBlock.header.first">
      <Setter Property="Margin" Value="16,6,16,6" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource Acrylic}" CornerRadius="8" BoxShadow="{DynamicResource ShadowLg}" BorderBrush="{DynamicResource FlyStroke}"
          BorderThickness="1" ClipToBounds="True">
    <StackPanel>
      <!-- The query: a focused Fluent text box, the accent along its bottom -->
      <Border Margin="12" Height="52" CornerRadius="4" Background="{DynamicResource Ctrl}" BorderBrush="{DynamicResource CtrlStroke}" BorderThickness="1" ClipToBounds="True">
        <Panel>
          <Grid Margin="14,0" ColumnDefinitions="Auto,12,*,Auto">
            <c:Icon Glyph="search" Size="22" Foreground="{DynamicResource Fg2}" />
            <TextBox Name="QueryBox" Grid.Column="2" Classes="bare" Text="{Binding Query}" FontSize="20" PlaceholderText="Search notes and lectures"
                     CaretBrush="{DynamicResource Fg}" />
            <TextBlock Grid.Column="3" Text="{Binding AskHint}" IsVisible="{Binding Searching}" FontSize="12" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </Grid>
          <Border Height="2" Background="{DynamicResource Accent}" VerticalAlignment="Bottom" />
        </Panel>
      </Border>

      <!-- The answer -->
      <Border IsVisible="{Binding Answering}" Margin="12,0" Padding="16" CornerRadius="8" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock Text="From your notes" FontSize="12" Foreground="{DynamicResource Fg2}" />
          <c:Spinner IsVisible="{Binding Thinking}" Width="16" Height="16" HorizontalAlignment="Left" Foreground="{DynamicResource Accent}" />
          <SelectableTextBlock Text="{Binding Answer}" FontSize="15" LineHeight="23.25" TextWrapping="Wrap" SelectionBrush="{DynamicResource Hl}" />
        </StackPanel>
      </Border>

      <TextBlock IsVisible="{Binding HasNote}" Text="{Binding Note}" FontSize="14" Foreground="{DynamicResource Fg2}" Margin="16,4,16,12" TextWrapping="Wrap" />

      <!-- Results, or the answer's sources -->
      <ItemsControl ItemsSource="{Binding Rows}" Margin="4,0,4,8" Classes.answer="{Binding Answering}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:QuickRow">
            <Panel>
              <TextBlock IsVisible="{Binding IsHeader}" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Classes="header" Classes.first="{Binding First}" />
              <Button IsVisible="{Binding Selectable}" Classes="qrow" Classes.selected="{Binding Selected}"
                      Command="{Binding $parent[UserControl].((vm:QuickModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                <Panel>
                  <Border Classes="pill" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                  <!-- A lecture -->
                  <Grid IsVisible="{Binding IsLecture}" Height="40" Margin="12,0" ColumnDefinitions="Auto,12,*,Auto">
                    <Border Classes="dot" Width="8" Height="8" CornerRadius="4" Background="{Binding Dot}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Classes="meta" Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" Margin="12,0,0,0" />
                  </Grid>
                  <!-- A passage from notes -->
                  <Grid IsVisible="{Binding IsPassage}" Margin="12,8" ColumnDefinitions="Auto,12,*">
                    <Border Classes="dot" Width="8" Height="8" CornerRadius="4" Background="{Binding Dot}" VerticalAlignment="Top" Margin="0,6,0,0" />
                    <StackPanel Grid.Column="2">
                      <c:Marked Source="{Binding Title}" Terms="{Binding $parent[UserControl].((vm:QuickModel)DataContext).Query}" Mark="{DynamicResource Hl}"
                                MarkWeight="SemiBold" FontSize="14" LineHeight="19.6" TextWrapping="Wrap" />
                      <TextBlock Classes="meta" Text="{Binding Sub}" FontSize="12" Foreground="{DynamicResource Fg2}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                  <!-- A class -->
                  <Grid IsVisible="{Binding IsClass}" Height="40" Margin="12,0" ColumnDefinitions="Auto,12,*,Auto">
                    <Border Classes="dot" Width="8" Height="8" CornerRadius="4" Background="{Binding Dot}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Classes="meta" Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                  </Grid>
                  <!-- An action -->
                  <Grid IsVisible="{Binding IsAction}" Height="40" Margin="10,0" ColumnDefinitions="Auto,12,*,Auto">
                    <c:Icon Glyph="{Binding Glyph}" Size="18" Foreground="{DynamicResource Fg2}" />
                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Classes="meta" Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" />
                  </Grid>
                  <!-- A source of an answer -->
                  <Grid IsVisible="{Binding IsSource}" Height="40" Margin="12,0" ColumnDefinitions="Auto,12,*,Auto">
                    <c:Icon Classes="source" Glyph="play_circle" Size="18" Foreground="{DynamicResource Fg2}" />
                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Classes="meta num" Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                  </Grid>
                </Panel>
              </Button>
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Keys, on the footer band -->
      <Border Height="40" Background="{DynamicResource Footer}" BorderBrush="{DynamicResource Sep}" BorderThickness="0,1,0,0">
      <Grid Margin="16,0" ColumnDefinitions="Auto,16,Auto,16,Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Searching}">
          <Border Classes="kbd"><TextBlock Text="↑↓" /></Border>
          <TextBlock Text="Move" FontSize="12" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <Border Classes="kbd"><TextBlock Text="{Binding OpenKey}" /></Border>
          <TextBlock Text="Open" FontSize="12" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" IsVisible="{Binding Searching}" />
          <TextBlock Text="Open source" FontSize="12" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" IsVisible="{Binding Answering}" />
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
          <Border Classes="kbd" IsVisible="{Binding Searching}"><TextBlock Text="{Binding AskKey}" /></Border>
          <TextBlock Text="Ask" FontSize="12" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" IsVisible="{Binding Searching}" />
          <Border Classes="kbd" IsVisible="{Binding Answering}"><TextBlock Text="{Binding CopyKey}" /></Border>
          <TextBlock Text="Copy answer" FontSize="12" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" IsVisible="{Binding Answering}" />
        </StackPanel>
        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6">
          <Border Classes="kbd"><TextBlock Text="{Binding CloseKey}" /></Border>
          <TextBlock Text="Close" FontSize="12" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
