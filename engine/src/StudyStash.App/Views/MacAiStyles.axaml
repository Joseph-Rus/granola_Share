<!-- Shared looks for the Mac's AI screens (13–18): the settings pane's title and groups, pills, selects, the state
     dot, a toggle switch and a radio, all in Liquid Glass. Included from each AI UserControl, never from Styles.axaml
     (WS2's). -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="TextBlock.ai-title">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.ai-sub">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19.5" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.ai-section">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.ai-link">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
  </Style>

  <Style Selector="Border.ai-group">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="{DynamicResource Group}" />
  </Style>
  <Style Selector="Border.ai-sep">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Sep}" />
    <Setter Property="Margin" Value="16,0,0,0" />
  </Style>
  <Style Selector="Grid.ai-row">
    <Setter Property="MinHeight" Value="56" />
  </Style>
  <Style Selector="StackPanel.ai-row-text">
    <Setter Property="Spacing" Value="2" />
  </Style>
  <Style Selector="TextBlock.ai-row-title">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.ai-row-sub">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>

  <Style Selector="Border.ai-tile">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource Fill2}" />
  </Style>

  <Style Selector="Ellipse.ai-dot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Fill" Value="{DynamicResource Fg3}" />
  </Style>
  <Style Selector="Ellipse.ai-dot.good">
    <Setter Property="Fill" Value="{DynamicResource Good}" />
  </Style>
  <Style Selector="Ellipse.ai-dot.warn">
    <Setter Property="Fill" Value="{DynamicResource Warn}" />
  </Style>
  <Style Selector="TextBlock.ai-state">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="TextBlock.ai-state.warn">
    <Setter Property="Foreground" Value="{DynamicResource Warn}" />
  </Style>

  <!-- The design's pill button: plain (Raised) or primary (Tint), 30 tall, r15. -->
  <Style Selector="Border.ai-pill">
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="{DynamicResource Raised}" />
    <Setter Property="BoxShadow" Value="{DynamicResource RaisedShadow}" />
  </Style>
  <Style Selector="Border.ai-pill > TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.ai-pill.primary">
    <Setter Property="Background" Value="{DynamicResource Tint}" />
    <Setter Property="BoxShadow" Value="{DynamicResource EdgeTint}" />
  </Style>
  <Style Selector="Border.ai-pill.primary > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.ai-pillbtn">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="CornerRadius" Value="15" />
  </Style>
  <Style Selector="Button.ai-textbtn">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
  </Style>

  <!-- The design's select: a pill with a name and unfold_more, opening a Flyout. -->
  <Style Selector="Border.ai-select">
    <Setter Property="Height" Value="28" />
    <Setter Property="Width" Value="180" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{DynamicResource Raised}" />
    <Setter Property="BoxShadow" Value="{DynamicResource RaisedShadow}" />
    <Setter Property="Padding" Value="12,0,8,0" />
  </Style>
  <Style Selector="Border.ai-select TextBlock">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.ai-select-btn">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="MenuItem.ai-item">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Styles.Resources>
    <!-- The menu (the "Answer with" / "Add an engine" look, in miniature for 13's own selects). -->
    <ControlTheme x:Key="AiMenuFlyout" TargetType="MenuFlyoutPresenter">
      <Setter Property="Background" Value="{DynamicResource GlassSolid}" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="MinWidth" Value="180" />
    </ControlTheme>

    <!-- A toggle switch: 38×22, r11, the knob 18, white. -->
    <ControlTheme x:Key="AiToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Track" CornerRadius="11" Background="{DynamicResource Fill2}">
            <Border Name="Knob" Width="18" Height="18" CornerRadius="9" Background="White" HorizontalAlignment="Left" Margin="2,0,0,0"
                    BoxShadow="0 1 3 0 #40000000" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ Border#Track">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
      </Style>
      <Style Selector="^:checked /template/ Border#Knob">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,2,0" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <!-- A radio: 16, on = Accent fill with a 6px white dot; off = a 1px Fg3 ring. -->
  <Style Selector="Border.ai-radio">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderBrush" Value="{DynamicResource Fg3}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.ai-radio.on">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
</Styles>
