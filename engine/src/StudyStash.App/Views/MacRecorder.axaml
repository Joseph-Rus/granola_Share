<!-- The floating recorder (Surfaces, macOS 02), in Liquid Glass: a pill, 320 × 56, recording or paused; expanded,
     360 × 520, the transcript fading upward and a chat below whose answers link to moments in the recording. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             x:Class="StudyStash.App.Views.MacRecorder"
             x:DataType="vm:RecorderModel"
             ClipToBounds="False">
  <UserControl.Styles>
    <!-- Round buttons stay round when hovered or pressed: the corner is half the size. -->
    <Style Selector="Button.round">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.old">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector="TextBlock.paused">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <!-- The pill -->
    <c:Glass IsVisible="{Binding !Expanded}" Width="320" Height="56" CornerRadius="28" Padding="18,0,8,0">
      <Grid ColumnDefinitions="Auto,10,Auto,10,Auto,10,Auto,*,Auto">
        <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource Accent}" BoxShadow="{DynamicResource Ring4}" VerticalAlignment="Center"
                IsVisible="{Binding IsRunning}" />
        <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource Fg3}" VerticalAlignment="Center" IsVisible="{Binding IsPaused}" />
        <TextBlock Grid.Column="2" Classes="num" Text="{Binding Elapsed}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                   Classes.paused="{Binding IsPaused}" />
        <c:Waveform Grid.Column="4" Bars="5" Height="20" MinBar="4" Levels="{Binding Levels}" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center"
                    IsVisible="{Binding IsRunning}" />
        <TextBlock Grid.Column="4" Text="Paused" FontSize="13" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" IsVisible="{Binding IsPaused}" />
        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6" Fill="{Binding ClassDot}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding DisplayClass}" FontSize="13" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="round fill2" Command="{Binding PauseCommand}" ToolTip.Tip="{Binding PauseTip}">
            <Panel>
              <c:Icon Glyph="pause" Filled="True" Size="20" Foreground="{DynamicResource Fg}" IsVisible="{Binding IsRunning}" />
              <c:Icon Glyph="play_arrow" Filled="True" Size="22" Foreground="{DynamicResource Fg}" IsVisible="{Binding IsPaused}" />
            </Panel>
          </Button>
          <Button Classes="round tint" Command="{Binding StopCommand}" ToolTip.Tip="Stop">
            <c:Icon Glyph="stop" Filled="True" Size="20" Foreground="{DynamicResource OnAccent}" />
          </Button>
        </StackPanel>
      </Grid>
    </c:Glass>

    <!-- Expanded: the glass keeps its shadow outside; the Border inside cuts what scrolls to its corners. -->
    <c:Glass IsVisible="{Binding Expanded}" Width="360" Height="520" CornerRadius="28">
      <Border CornerRadius="28" ClipToBounds="True">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Height="60" Margin="20,0,12,0" ColumnDefinitions="Auto,10,Auto,10,Auto,*,Auto">
            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Accent}" BoxShadow="{DynamicResource Ring3}" VerticalAlignment="Center"
                    IsVisible="{Binding IsRunning}" />
            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Fg3}" VerticalAlignment="Center" IsVisible="{Binding IsPaused}" />
            <TextBlock Grid.Column="2" Text="{Binding DisplayClass}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Classes="num" Text="{Binding Elapsed}" FontSize="13" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
            <!-- Make it small, pause, stop: one pill of three round buttons -->
            <Border Grid.Column="6" Classes="fill" CornerRadius="20" Padding="3" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="small" Command="{Binding ToggleCommand}" ToolTip.Tip="Make it small">
                  <c:Icon Glyph="close_fullscreen" Size="18" Foreground="{DynamicResource Fg2}" />
                </Button>
                <Button Classes="small" Command="{Binding PauseCommand}" ToolTip.Tip="{Binding PauseTip}">
                  <c:Icon Glyph="{Binding PauseGlyph}" Filled="True" Size="18" Foreground="{DynamicResource Fg}" />
                </Button>
                <Button Classes="small tint" Command="{Binding StopCommand}" ToolTip.Tip="Stop">
                  <c:Icon Glyph="stop" Filled="True" Size="18" Foreground="{DynamicResource OnAccent}" />
                </Button>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Ask about this lecture -->
          <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="12,4,12,12">
            <!-- Not clipped: your bubble glows past its edge. -->
            <ItemsControl ItemsSource="{Binding Chat}" ClipToBounds="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatMessage">
                  <Panel>
                    <!-- Yours: text at most 78% of the 336 across, the answer's 88%, each plus its padding (as the design's CSS) -->
                    <Border Classes="tint" IsVisible="{Binding Mine}" HorizontalAlignment="Right" MaxWidth="290" CornerRadius="18" Padding="14,8">
                      <TextBlock Text="{Binding Text}" FontSize="13" LineHeight="18.2" TextWrapping="Wrap" Foreground="{DynamicResource OnAccent}" />
                    </Border>
                    <Border Classes="fill" IsVisible="{Binding !Mine}" HorizontalAlignment="Left" MaxWidth="324" CornerRadius="18" Padding="14,10">
                      <StackPanel Spacing="8">
                        <c:Spinner IsVisible="{Binding Thinking}" Width="14" Height="14" HorizontalAlignment="Left" Foreground="{DynamicResource Fg2}" />
                        <TextBlock Text="{Binding Text}" FontSize="13" LineHeight="18.85" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Sources}" IsVisible="{Binding HasSources}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SourceChip">
                              <Button Classes="fill2" Theme="{StaticResource Surface}" Height="26" CornerRadius="13" Padding="8,0,10,0"
                                      Command="{Binding $parent[UserControl].((vm:RecorderModel)DataContext).PlayCommand}" CommandParameter="{Binding}"
                                      ToolTip.Tip="Play from here">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                  <c:Icon Glyph="play_arrow" Filled="True" Size="15" Foreground="{DynamicResource AccentText}" />
                                  <TextBlock Classes="num" Text="{Binding Label}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="fill" Height="44" CornerRadius="22" Padding="16,0,6,0" Margin="0,2,0,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Classes="bare" Text="{Binding Question}" PlaceholderText="Ask about this lecture" PlaceholderForeground="{DynamicResource Fg2}" FontSize="13">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AskCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Classes="small" Background="{DynamicResource Fill2}" Command="{Binding AskCommand}" ToolTip.Tip="Ask">
                  <c:Icon Glyph="arrow_upward" Size="18" Foreground="{DynamicResource Fg2}" />
                </Button>
              </Grid>
            </Border>
          </StackPanel>

          <!-- What's been said, newest at the bottom, fading out toward the top -->
          <ScrollViewer Name="Heard" Padding="20,0,20,16" VerticalScrollBarVisibility="Hidden">
            <ScrollViewer.OpacityMask>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="Transparent" Offset="0" />
                <GradientStop Color="Black" Offset="0.55" />
              </LinearGradientBrush>
            </ScrollViewer.OpacityMask>
            <Panel VerticalAlignment="Bottom">
              <TextBlock IsVisible="{Binding NoLines}" Text="{Binding Waiting}" FontSize="13" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HeardLine">
                    <Grid ColumnDefinitions="34,10,*">
                      <TextBlock Classes="num" Text="{Binding Time}" FontSize="11" Foreground="{DynamicResource Fg2}" Margin="0,2,0,0" />
                      <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="13" LineHeight="18.85" TextWrapping="Wrap"
                                 Classes.old="{Binding !Latest}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </c:Glass>
  </Panel>
</UserControl>
