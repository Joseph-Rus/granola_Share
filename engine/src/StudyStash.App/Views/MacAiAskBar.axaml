<!-- The ask bar under a lecture's notes (design 16): a field, an engine chip opening "Answer with", a scope chip,
     and a send button, with the latest answer floating above it once there is one. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.MacAiAskBar"
             x:DataType="vm:AiAskModel"
             ClipToBounds="False">
  <UserControl.Styles>
    <StyleInclude Source="avares://StudyStash/Views/MacAiStyles.axaml" />
  </UserControl.Styles>

  <StackPanel Spacing="12" ClipToBounds="False">
    <ContentControl IsVisible="{Binding HasLatest}" Content="{Binding Latest}" HorizontalAlignment="Center">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:AiTurn">
          <Border Classes="ai-bubble-a" Width="560">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsThinking}">
                <c:Spinner Width="14" Height="14" Foreground="{DynamicResource Fg2}" />
                <TextBlock Classes="ai-thinking" Text="{Binding ThinkingWords}" />
              </StackPanel>
              <TextBlock Classes="ai-answer" Text="{Binding Failed}" Foreground="{DynamicResource Warn}"
                         IsVisible="{Binding Failed, Converter={x:Static c:Converters.NotEmpty}}" />
              <StackPanel Spacing="6" IsVisible="{Binding !IsThinking}">
                <TextBlock Classes="ai-answer" Text="{Binding Answer}" IsVisible="{Binding Answer, Converter={x:Static c:Converters.NotEmpty}}" />
                <Button Theme="{StaticResource Surface}" Padding="0" HorizontalContentAlignment="Left"
                        Command="{Binding $parent[UserControl].((vm:AiAskModel)DataContext).OpenTurnSourceCommand}" CommandParameter="{Binding}"
                        IsVisible="{Binding Byline, Converter={x:Static c:Converters.NotEmpty}}">
                  <TextBlock Classes="ai-byline" Text="{Binding Byline}" />
                </Button>
                <TextBlock Classes="ai-byline" Text="{Binding FellBackNote}" IsVisible="{Binding FellBackNote, Converter={x:Static c:Converters.NotEmpty}}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <c:Glass CornerRadius="24" Padding="20,0,8,0" Height="48" Width="560" ClipToBounds="False">
      <Grid ColumnDefinitions="*,8,Auto,8,Auto,8,Auto" VerticalAlignment="Center">
        <TextBox Classes="bare" Text="{Binding Question}" PlaceholderText="{Binding Placeholder}" FontSize="13" VerticalAlignment="Center">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding AskCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Name="EngineChip" Grid.Column="2" Classes="ai-chipbtn" VerticalAlignment="Center">
          <Border Classes="ai-chip ai-chip-engine">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <c:Icon Glyph="auto_awesome" Size="14" Foreground="{DynamicResource AccentText}" />
              <TextBlock Text="{Binding EngineName}" TextTrimming="CharacterEllipsis" />
              <c:Icon Glyph="unfold_more" Size="15" Foreground="{DynamicResource Fg2}" />
            </StackPanel>
          </Border>
          <Button.Flyout>
            <Flyout Placement="Top" ShowMode="Standard">
              <ContentControl Content="{Binding Menu}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:EngineMenuModel">
                    <v:MacAiEngineMenu />
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button Grid.Column="4" Classes="ai-chipbtn" VerticalAlignment="Center">
          <Border Classes="ai-chip ai-chip-scope">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <TextBlock Text="{Binding ScopeName}" />
              <c:Icon Glyph="unfold_more" Size="15" Foreground="{DynamicResource Fg2}" />
            </StackPanel>
          </Border>
          <Button.Flyout>
            <MenuFlyout Placement="Top" FlyoutPresenterTheme="{StaticResource AiMenuFlyout}" ItemsSource="{Binding ScopeChoices}">
              <MenuFlyout.ItemTemplate>
                <DataTemplate x:DataType="vm:EngineChoice">
                  <MenuItem Classes="ai-item" Header="{Binding Name}" Command="{Binding Pick}" />
                </DataTemplate>
              </MenuFlyout.ItemTemplate>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Grid.Column="6" Classes="ai-send" Command="{Binding AskCommand}" VerticalAlignment="Center">
          <c:Icon Glyph="arrow_upward" Size="18" Foreground="{DynamicResource Fg2}" />
        </Button>
      </Grid>
    </c:Glass>
  </StackPanel>
</UserControl>
