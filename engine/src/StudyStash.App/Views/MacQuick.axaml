<!-- The quick panel (Surfaces, macOS 03): ⌥Space. Results grouped as Lectures, Passages, Classes, Actions; the selection
     uses the accent. ⌘Return turns the query into a question answered from your notes, with sources. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             x:Class="StudyStash.App.Views.MacQuick"
             x:DataType="vm:QuickModel"
             Width="680" ClipToBounds="False">
  <UserControl.Styles>
    <Style Selector="Border.kbd">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource Fill2}" />
    </Style>
    <Style Selector="Border.kbd > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector="Button.qrow">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.qrow.selected">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Button.qrow.selected TextBlock.meta">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="Button.qrow.selected c|Icon">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Button.qrow.selected Border.dot">
      <Setter Property="BoxShadow" Value="0 0 0 1.5 #FFFFFF" />
    </Style>
    <Style Selector="Button.qrow.selected c|Marked">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="Margin" Value="12,10,12,4" />
    </Style>
    <Style Selector="TextBlock.header.first">
      <Setter Property="Margin" Value="12,8,12,4" />
    </Style>
    <Style Selector="TextBlock.enter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.qrow.selected TextBlock.enter">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.qrow.selected c|Icon.source">
      <Setter Property="Filled" Value="True" />
    </Style>
    <Style Selector="ItemsControl.answer">
      <Setter Property="Margin" Value="8,0,8,8" />
    </Style>
    <Style Selector="ItemsControl.answer TextBlock.header.first">
      <Setter Property="Margin" Value="12,4,12,4" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource Mat}" CornerRadius="16" BoxShadow="{DynamicResource Shadow}" ClipToBounds="True">
    <StackPanel>
      <!-- The query -->
      <Grid Height="60" Margin="20,0" ColumnDefinitions="Auto,12,*,Auto">
        <c:Icon Glyph="search" Size="24" Foreground="{DynamicResource Fg2}" />
        <TextBox Name="QueryBox" Grid.Column="2" Classes="bare" Text="{Binding Query}" FontSize="22" PlaceholderText="Search notes and lectures"
                 CaretBrush="{DynamicResource Accent}" />
        <TextBlock Grid.Column="3" Text="{Binding AskHint}" IsVisible="{Binding Searching}" FontSize="12" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>
      <Border Height="1" Background="{DynamicResource Sep}" />

      <!-- The answer -->
      <StackPanel IsVisible="{Binding Answering}" Spacing="12" Margin="20,16,20,12">
        <TextBlock Text="From your notes" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Fg2}" />
        <c:Spinner IsVisible="{Binding Thinking}" Width="16" Height="16" HorizontalAlignment="Left" Foreground="{DynamicResource Fg2}" />
        <SelectableTextBlock Text="{Binding Answer}" FontFamily="{DynamicResource SerifFont}" FontSize="16" LineHeight="24.8" TextWrapping="Wrap"
                             SelectionBrush="{DynamicResource Hl}" />
      </StackPanel>

      <TextBlock IsVisible="{Binding HasNote}" Text="{Binding Note}" FontSize="13" Foreground="{DynamicResource Fg2}" Margin="20,16" TextWrapping="Wrap" />

      <!-- Results, or the answer's sources -->
      <ItemsControl ItemsSource="{Binding Rows}" Margin="8,6,8,8" Classes.answer="{Binding Answering}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:QuickRow">
            <Panel>
              <TextBlock IsVisible="{Binding IsHeader}" Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Fg2}"
                         Classes="header" Classes.first="{Binding First}" />
              <Button IsVisible="{Binding Selectable}" Classes="qrow" Classes.selected="{Binding Selected}"
                      Command="{Binding $parent[UserControl].((vm:QuickModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                <Panel>
                  <!-- A lecture -->
                  <Grid IsVisible="{Binding IsLecture}" Height="40" Margin="12,0" ColumnDefinitions="Auto,10,*,Auto,Auto">
                    <Border Classes="dot" Width="8" Height="8" CornerRadius="4" Background="{Binding Dot}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Classes="meta" Text="{Binding Meta}" FontSize="13" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <Panel Grid.Column="4" Width="22">
                      <TextBlock Classes="enter meta" Text="↩" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Panel>
                  </Grid>
                  <!-- A passage from notes -->
                  <Grid IsVisible="{Binding IsPassage}" Margin="12,8" ColumnDefinitions="Auto,10,*">
                    <Border Classes="dot" Width="8" Height="8" CornerRadius="4" Background="{Binding Dot}" VerticalAlignment="Top" Margin="0,5,0,0" />
                    <StackPanel Grid.Column="2">
                      <c:Marked Source="{Binding Title}" Terms="{Binding $parent[UserControl].((vm:QuickModel)DataContext).Query}" Mark="{DynamicResource Hl}"
                                FontSize="13" LineHeight="18.2" TextWrapping="Wrap" />
                      <TextBlock Classes="meta" Text="{Binding Sub}" FontSize="11" Foreground="{DynamicResource Fg2}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                  <!-- A class -->
                  <Grid IsVisible="{Binding IsClass}" Height="36" Margin="12,0" ColumnDefinitions="Auto,10,*,Auto">
                    <Border Classes="dot" Width="8" Height="8" CornerRadius="4" Background="{Binding Dot}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Classes="meta" Text="{Binding Meta}" FontSize="13" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                  </Grid>
                  <!-- An action -->
                  <Grid IsVisible="{Binding IsAction}" Height="36" Margin="10,0" ColumnDefinitions="Auto,10,*,Auto">
                    <c:Icon Glyph="{Binding Glyph}" Size="18" Foreground="{DynamicResource Fg2}" />
                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Classes="meta" Text="{Binding Meta}" FontSize="13" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" />
                  </Grid>
                  <!-- A source of an answer -->
                  <Grid IsVisible="{Binding IsSource}" Height="40" Margin="12,0" ColumnDefinitions="Auto,10,*,Auto">
                    <c:Icon Classes="source" Glyph="play_circle" Size="18" Foreground="{DynamicResource Fg2}" />
                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Classes="meta num" Text="{Binding Meta}" FontSize="13" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                  </Grid>
                </Panel>
              </Button>
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Keys -->
      <Border Height="1" Background="{DynamicResource Sep}" />
      <Grid Height="36" Margin="20,0" ColumnDefinitions="Auto,16,Auto,16,Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Searching}">
          <Border Classes="kbd"><TextBlock Text="↑↓" /></Border>
          <TextBlock Text="Move" FontSize="11" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <Border Classes="kbd"><TextBlock Text="{Binding OpenKey}" /></Border>
          <TextBlock Text="Open" FontSize="11" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" IsVisible="{Binding Searching}" />
          <TextBlock Text="Open source" FontSize="11" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" IsVisible="{Binding Answering}" />
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
          <Border Classes="kbd" IsVisible="{Binding Searching}"><TextBlock Text="{Binding AskKey}" /></Border>
          <TextBlock Text="Ask" FontSize="11" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" IsVisible="{Binding Searching}" />
          <Border Classes="kbd" IsVisible="{Binding Answering}"><TextBlock Text="{Binding CopyKey}" /></Border>
          <TextBlock Text="Copy answer" FontSize="11" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" IsVisible="{Binding Answering}" />
        </StackPanel>
        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6">
          <Border Classes="kbd"><TextBlock Text="{Binding CloseKey}" /></Border>
          <TextBlock Text="Close" FontSize="11" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
