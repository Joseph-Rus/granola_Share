<!-- First-run setup (Surfaces, Windows 11 05): the same four steps, plus one for Windows: pin the tray icon out of the
     overflow, with a shortcut to taskbar settings. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             x:Class="StudyStash.App.Views.WinSetup"
             x:DataType="vm:SetupModel"
             Width="720" Height="480">
  <UserControl.Styles>
    <Style Selector="Border.step">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Border.step.current">
      <Setter Property="Background" Value="{DynamicResource Subtle}" />
    </Style>
    <Style Selector="Border.step TextBlock.title">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector="Border.step.current TextBlock.title">
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.step.todo TextBlock.title">
      <Setter Property="Foreground" Value="{DynamicResource Fg3}" />
    </Style>
    <Style Selector="Border.pill">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.step.current Border.pill">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border.num">
      <Setter Property="BorderBrush" Value="{DynamicResource Fg3}" />
    </Style>
    <Style Selector="Border.step.current Border.num">
      <Setter Property="BorderBrush" Value="{DynamicResource Fg}" />
    </Style>
    <Style Selector="Border.num TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Fg3}" />
    </Style>
    <Style Selector="Border.step.current Border.num TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    </Style>
    <Style Selector="Button.push">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Ctrl}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.default">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.default TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.choice">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Background" Value="{DynamicResource Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.choice.on">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.field">
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource Ctrl}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="11,0" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Button.caption">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="32" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource Mica}" BorderBrush="{DynamicResource FlyStroke}" BorderThickness="1" CornerRadius="8" BoxShadow="{DynamicResource ShadowLg}" ClipToBounds="True">
    <DockPanel>
      <Grid DockPanel.Dock="Top" Height="32" ColumnDefinitions="*,Auto" Name="TitleBar">
        <TextBlock Text="Set up Study Stash" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Name="Captions">
          <Button Classes="caption"><c:Icon Glyph="remove" Size="15" Foreground="{DynamicResource Fg}" /></Button>
          <Button Classes="caption"><c:Icon Glyph="close" Size="15" Foreground="{DynamicResource Fg}" /></Button>
        </StackPanel>
      </Grid>
      <Grid ColumnDefinitions="208,*">
        <ItemsControl ItemsSource="{Binding Steps}" Margin="8,12">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StepItem">
              <Border Classes="step" Classes.current="{Binding Current}" Classes.todo="{Binding Todo}">
                <Panel>
                  <Border Classes="pill" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Margin="-12,0,0,0" />
                  <Grid ColumnDefinitions="Auto,12,*,Auto">
                    <c:Icon IsVisible="{Binding Done}" Glyph="check_circle" Filled="True" Size="18" Foreground="{DynamicResource AccentText}" />
                    <Border IsVisible="{Binding ShowNumber}" Classes="num" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5">
                      <TextBlock Text="{Binding Number}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="2" Classes="title" Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="Optional" IsVisible="{Binding Optional}" FontSize="12" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" />
                  </Grid>
                </Panel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Column="1" Background="{DynamicResource Layer}" BorderBrush="{DynamicResource LayerStroke}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
          <DockPanel>
            <Border DockPanel.Dock="Bottom" Height="64" Background="{DynamicResource Footer}" BorderBrush="{DynamicResource Sep}" BorderThickness="0,1,0,0" Padding="24,0">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                <Button Classes="push" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}"><TextBlock Text="Back" FontSize="14" /></Button>
                <Button Classes="push default" Command="{Binding NextCommand}"><TextBlock Text="{Binding ContinueLabel}" FontSize="14" /></Button>
              </StackPanel>
            </Border>
            <StackPanel Margin="36,36,36,0">
              <TextBlock Text="{Binding StepLabel}" FontSize="12" Foreground="{DynamicResource Fg2}" />

          <!-- 1: the microphone -->
          <StackPanel IsVisible="{Binding OnMicrophone}">
            <TextBlock Text="Let Study Stash hear your lectures" FontFamily="{DynamicResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" />
            <TextBlock Text="It records with this PC's microphone. The recording stays on this PC; only the transcript goes to your library."
                       FontSize="14" LineHeight="21" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,32,0,0" IsVisible="{Binding MicAllowed}">
              <c:Icon Glyph="check_circle" Filled="True" Size="18" Foreground="{DynamicResource Accent}" />
              <TextBlock Text="The microphone is allowed." FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
            <Button Classes="push default" HorizontalAlignment="Left" Margin="0,32,0,0" Command="{Binding AllowMicCommand}" IsVisible="{Binding !MicAllowed}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Glyph="mic" Filled="True" Size="16" Foreground="{DynamicResource OnAccent}" />
                <TextBlock Text="Allow the microphone" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel IsVisible="{Binding MicDenied}" Margin="0,16,0,0" Spacing="8">
              <TextBlock Text="Windows is keeping the microphone from desktop apps. Turn on Settings → Privacy &amp; security → Microphone → Let desktop apps access your microphone."
                         FontSize="12" LineHeight="18" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" />
              <Button Classes="push" HorizontalAlignment="Left" Command="{Binding MicSettingsCommand}">
                <TextBlock Text="Open microphone settings" FontSize="14" />
              </Button>
            </StackPanel>
          </StackPanel>

          <!-- 2: the library -->
          <StackPanel IsVisible="{Binding OnLibrary}">
            <TextBlock Text="Where your notes live" FontFamily="{DynamicResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" />
            <TextBlock Text="Your library is the computer that writes the notes and keeps them: a Mac mini or a PC at home, or this PC."
                       FontSize="14" LineHeight="21" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" Margin="0,8,0,0" />
            <Grid ColumnDefinitions="*,10,*" Margin="0,20,0,0" MaxWidth="440" HorizontalAlignment="Left">
              <Button Classes="choice" Classes.on="{Binding OtherComputer}" Command="{Binding PickOtherCommand}">
                <StackPanel Spacing="4">
                  <c:Icon Glyph="dns" Size="20" Foreground="{DynamicResource Fg2}" HorizontalAlignment="Left" />
                  <TextBlock Text="Another computer" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock Text="Connect to the library you set up" FontSize="12" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" />
                </StackPanel>
              </Button>
              <Button Grid.Column="2" Classes="choice" Classes.on="{Binding ThisComputer}" Command="{Binding PickThisCommand}">
                <StackPanel Spacing="4">
                  <c:Icon Glyph="desktop_windows" Size="20" Foreground="{DynamicResource Fg2}" HorizontalAlignment="Left" />
                  <TextBlock Text="This PC" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock Text="Keep the library here too" FontSize="12" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" />
                </StackPanel>
              </Button>
            </Grid>
            <Grid ColumnDefinitions="*,10,*" Margin="0,16,0,0" MaxWidth="440" HorizontalAlignment="Left" IsVisible="{Binding OtherComputer}">
              <StackPanel>
                <TextBlock Classes="label" Text="Address" />
                <Border Classes="field"><TextBox Classes="bare" Text="{Binding Address}" PlaceholderText="http://mac-mini:8787" FontSize="14" /></Border>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Classes="label" Text="Password" />
                <Border Classes="field"><TextBox Classes="bare" Text="{Binding Password}" PasswordChar="•" FontSize="14" /></Border>
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,10,*" Margin="0,16,0,0" MaxWidth="440" HorizontalAlignment="Left" IsVisible="{Binding ThisComputer}">
              <StackPanel>
                <TextBlock Classes="label" Text="Library name" />
                <Border Classes="field"><TextBox Classes="bare" Text="{Binding LibraryName}" PlaceholderText="Sam's library" FontSize="14" /></Border>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Classes="label" Text="Password" />
                <Border Classes="field"><TextBox Classes="bare" Text="{Binding Password}" PasswordChar="•" FontSize="14" /></Border>
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,14,0,0">
              <Button Classes="push" Command="{Binding ConnectCommand}" IsEnabled="{Binding !Connecting}">
                <TextBlock Text="{Binding ThisComputer, Converter={x:Static c:Converters.CreateOrConnect}}" FontSize="14" />
              </Button>
              <c:Spinner IsVisible="{Binding Connecting}" Width="14" Height="14" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
              <TextBlock IsVisible="{Binding HasLibraryResult}" Text="{Binding LibraryResult}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300"
                         Classes="result" Classes.bad="{Binding !LibraryOk}" />
            </StackPanel>
          </StackPanel>

          <!-- 3: the model -->
          <StackPanel IsVisible="{Binding OnModel}">
            <TextBlock Text="Download the transcription model" FontFamily="{DynamicResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" />
            <TextBlock Text="{Binding ModelBody}" FontSize="14" LineHeight="21" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" Margin="0,8,0,0" />
            <Border Height="4" MaxWidth="440" HorizontalAlignment="Stretch" Margin="0,32,0,0">
              <Grid ColumnDefinitions="Auto,*"><Border Width="{Binding ModelBarWidthWin}" Height="4" CornerRadius="2" Background="{DynamicResource Accent}" /><Border Grid.Column="1" Height="1" Background="{DynamicResource Fg3}" VerticalAlignment="Center" /></Grid>
            </Border>
            <Grid ColumnDefinitions="*,Auto" MaxWidth="440" Margin="0,8,0,0">
              <TextBlock Classes="num" Text="{Binding ModelDone}" FontSize="12" Foreground="{DynamicResource Fg2}" />
              <TextBlock Grid.Column="1" Classes="num" Text="{Binding ModelLeft}" FontSize="12" Foreground="{DynamicResource Fg2}" />
            </Grid>
            <TextBlock IsVisible="{Binding ModelDownloading}" Text="You can add your classes while this finishes." FontSize="12" Foreground="{DynamicResource Fg2}" Margin="0,24,0,0" />
            <StackPanel IsVisible="{Binding HasModelProblem}" Orientation="Horizontal" Spacing="10" Margin="0,20,0,0">
              <TextBlock Text="{Binding ModelProblem}" FontSize="12" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
              <Button Classes="push" Command="{Binding RetryModelCommand}"><TextBlock Text="Try again" FontSize="14" /></Button>
            </StackPanel>
          </StackPanel>

          <!-- 4: classes -->
          <StackPanel IsVisible="{Binding OnClasses}">
            <TextBlock Text="Add your classes" FontFamily="{DynamicResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" />
            <TextBlock Text="With your timetable, Record picks the class that's on, so each lecture lands in the right place. You can skip this."
                       FontSize="14" LineHeight="21" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding Classes}" Margin="0,18,0,0" MaxWidth="440" HorizontalAlignment="Left">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SetupClass">
                  <Grid ColumnDefinitions="Auto,10,*,Auto" Height="30">
                    <Ellipse Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding When}" FontSize="12" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="140,10,*,10,Auto" Margin="0,10,0,0" MaxWidth="440" HorizontalAlignment="Left">
              <Border Classes="field"><TextBox Classes="bare" Text="{Binding NewClass}" PlaceholderText="CS 101" FontSize="14" /></Border>
              <Border Grid.Column="2" Classes="field"><TextBox Classes="bare" Text="{Binding NewWhen}" PlaceholderText="Tue Thu 10:00–11:15" FontSize="14" /></Border>
              <Button Grid.Column="4" Classes="push" Command="{Binding AddClassCommand}"><TextBlock Text="Add" FontSize="14" /></Button>
            </Grid>
            <TextBlock IsVisible="{Binding HasClassProblem}" Text="{Binding ClassProblem}" FontSize="12" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" MaxWidth="440" HorizontalAlignment="Left" Margin="0,8,0,0" />
          </StackPanel>

              <!-- 5: the taskbar -->
              <StackPanel IsVisible="{Binding OnTaskbar}">
                <TextBlock Text="Keep Study Stash on the taskbar" FontFamily="{DynamicResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" />
                <TextBlock Text="Windows tucks new icons away under ^. Drag Study Stash next to the clock so Record is always one click away."
                           FontSize="14" LineHeight="21" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" Margin="0,8,0,0" />
                <Border Margin="0,24,0,0" Padding="20" CornerRadius="8" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
                  <Grid ColumnDefinitions="Auto,16,*">
                    <StackPanel Spacing="6" VerticalAlignment="Bottom">
                      <Border Padding="6" CornerRadius="8" Background="{DynamicResource Acrylic}" BorderBrush="{DynamicResource FlyStroke}" BorderThickness="1"
                              BoxShadow="{DynamicResource Shadow}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                          <Panel Width="32" Height="32"><c:Icon Glyph="cloud" Size="16" Foreground="{DynamicResource Fg3}" /></Panel>
                          <Border Width="32" Height="32" CornerRadius="4" BorderBrush="{DynamicResource Accent}" BorderThickness="2">
                            <c:Icon Glyph="graphic_eq" Size="17" Foreground="{DynamicResource Fg}" />
                          </Border>
                          <Panel Width="32" Height="32"><c:Icon Glyph="bluetooth" Size="16" Foreground="{DynamicResource Fg3}" /></Panel>
                        </StackPanel>
                      </Border>
                      <Border Height="40" CornerRadius="4" Background="{DynamicResource Taskbar}" BorderBrush="{DynamicResource FlyStroke}" BorderThickness="1" Padding="10,0">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                          <c:Icon Glyph="keyboard_arrow_up" Size="16" Foreground="{DynamicResource Fg}" />
                          <c:DashedBox Width="28" Height="28" Stroke="{DynamicResource Accent}" />
                          <c:Icon Glyph="wifi" Size="16" Foreground="{DynamicResource Fg}" />
                          <c:Icon Glyph="volume_up" Size="16" Foreground="{DynamicResource Fg}" />
                          <TextBlock Text="12:34" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="Select ^ in the taskbar corner, then drag the Study Stash icon down beside the clock." FontSize="14" LineHeight="21"
                               Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" MaxWidth="220" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                  </Grid>
                </Border>
                <Button Theme="{StaticResource Surface}" HorizontalAlignment="Left" Margin="0,14,0,0" CornerRadius="4" Padding="0" Command="{Binding TaskbarSettingsCommand}">
                  <TextBlock Text="Open taskbar settings instead" FontSize="14" Foreground="{DynamicResource AccentText}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
