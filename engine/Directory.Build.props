<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Numbers, dates and casing work the same on every computer, so the library's files read the same everywhere. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The one place Study Stash's version lives: CI publishes v<version> when it changes on main. The laptop and
         setup check it. -->
    <StudyStashVersion>0.4.4</StudyStashVersion>
    <Version>$(StudyStashVersion)</Version>
    <InformationalVersion>$(StudyStashVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
