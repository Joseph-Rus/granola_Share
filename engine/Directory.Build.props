<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Numbers, dates and casing work the same on every computer, the way the Python engine wrote them. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup>
    <!-- One version for both engines: granola_share/__init__.py's. The laptop and setup check it. -->
    <StudyStashVersion>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../granola_share/__init__.py')), '(?s).*__version__ = "([^"]+)".*', '$1'))</StudyStashVersion>
    <Version>$(StudyStashVersion)</Version>
    <InformationalVersion>$(StudyStashVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
