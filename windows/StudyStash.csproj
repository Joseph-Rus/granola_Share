<Project Sdk="Microsoft.NET.Sdk">
  <!-- Study Stash for Windows. .NET Framework 4.8 is part of every Windows 10 and 11, so the app is a few
       small files with nothing extra to install. Build and package with windows/build.ps1. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10</LangVersion>
    <AssemblyName>Study Stash</AssemblyName>
    <RootNamespace>StudyStash</RootNamespace>
    <ApplicationIcon>..\granola_share\assets\study-stash.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.0.0</Version>
    <Product>Study Stash</Product>
    <Company>Study Stash</Company>
    <Description>Study Stash</Description>
    <Copyright>MIT License. An independent project, not affiliated with or endorsed by Granola.</Copyright>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <!-- Lets the .NET SDK build for .NET Framework anywhere, including CI and a Mac (to check it compiles). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\granola_share\assets\study-stash.ico" LogicalName="study-stash.ico" />
    <EmbeddedResource Include="..\granola_share\assets\icon.png" LogicalName="icon.png" />
  </ItemGroup>
</Project>
